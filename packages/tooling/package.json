{
  "name": "@angulus/tooling",
  "version": "0.1.1",
  "description": "Angulus CLI, compiler integration and Vite plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/angulusjs/angulus.git",
    "directory": "packages/tooling"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/**/*.mjs",
    "types",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "angulus": "./src/cli.mjs"
  },
  "exports": {
    "./vite": {
      "types": "./types/vite.d.mts",
      "import": "./src/vite.mjs",
      "default": "./src/vite.mjs"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "magic-string": "0.30.21",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
