{
  "name": "angulus-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "npm run compiler && npm run packages:build",
    "compiler": "go run ./cmd/angulus-release build-cli",
    "dev": "angulus serve --root examples/demo",
    "check": "angulus check --root examples/demo",
    "build": "angulus build --root examples/demo",
    "preview": "angulus preview --root examples/demo",
    "test:browser": "playwright test",
    "pretest": "npm run compiler && npm run packages:build",
    "test": "go test ./... && tsx --test packages/core/test/*.test.ts packages/router/test/*.test.ts packages/forms/test/*.test.ts packages/http/test/*.test.ts packages/tooling/test/*.test.*",
    "typecheck": "node scripts/tsgo.mjs --noEmit -p tsconfig.json",
    "packages:build": "go run ./cmd/angulus-release build-packages",
    "packages:pack": "go run ./cmd/angulus-release pack",
    "packages:smoke": "node scripts/smoke-packages.mjs",
    "release:version": "go run ./cmd/angulus-release version",
    "release:publish": "go run ./cmd/angulus-release publish",
    "size": "go run ./cmd/angulus-release size"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.15",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "happy-dom": "20.14.5",
    "tsx": "4.23.15"
  }
}
